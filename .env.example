# =============================================================================
# D.A.N.T.E. — Variáveis de Ambiente
# Detection & Alerting Navigator for Threat Engineering
# -----------------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os valores:
#     cp .env.example .env          (Linux/macOS)
#     Copy-Item .env.example .env   (Windows PowerShell)
#
# O arquivo .env está no .gitignore e NUNCA deve ser versionado.
# Variáveis com validação rígida impedem a subida dos containers se inválidas.
# =============================================================================

# --- 1. Modo de Deploy -------------------------------------------------------
# default  -> Sobe o Grafana embutido e executa o bootstrap de credenciais/pastas.
# external -> Conecta a um Grafana existente externo (dispensa container grafana local).
COMPOSE_PROFILES=default

# --- 2. Conexão com o Grafana ------------------------------------------------
# URL interna que o backend usa para chamar as APIs do Grafana (Docker/rede interna).
# - Modo standalone (default): http://grafana:3000
# - Modo external: URL de rede do Grafana externo (ex: https://grafana.empresa.com ou http://192.168.1.50:3000)
GRAFANA_URL=http://grafana:3000

# URL pública que os navegadores dos analistas usam para acessar o Grafana e abrir links diretos.
# Se estiver acessando de outro host na rede, defina o IP ou hostname acessível externamente.
GRAFANA_PUBLIC_URL=http://localhost:3000

# Autenticação com Grafana:
# Opção A: Token de Service Account (obrigatório se COMPOSE_PROFILES=external).
#   Crie uma Service Account com perfil Admin/Editor no Grafana e insira o token glsa_...
GRAFANA_TOKEN=

# Opção B: Credenciais de Admin do Grafana (usado no Grafana embutido / bootstrap inicial).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Validação TLS/SSL para conexões com o Grafana (false se usar certificado autoassinado).
GRAFANA_VERIFY_TLS=true

# Versão e porta do Grafana embutido (ignorado se COMPOSE_PROFILES=external).
GRAFANA_VERSION=12.4.0
GRAFANA_PORT=3000

# --- 3. Loki (Telemetria e Synthetic Lab) -------------------------------------
# Versão da imagem oficial grafana/loki.
LOKI_VERSION=3.4.2
# Bind e porta do Loki no host.
# AVISO: Loki não possui autenticação nativa; mantenha o bind em 127.0.0.1.
LOKI_BIND_ADDRESS=127.0.0.1
LOKI_PORT=3100
# URL interna padrão do Loki usada na criação do datasource de cada tenant.
LOKI_TENANT_DATASOURCE_URL=http://loki:3100

# --- 4. Portal D.A.N.T.E. ----------------------------------------------------
# Interface de rede para bind do frontend (0.0.0.0 para todas as interfaces).
BIND_ADDRESS=0.0.0.0
# Porta HTTP exposta para o portal.
PORTAL_PORT=8080
# OBRIGATÓRIO: Credenciais do administrador local do portal (mínimo de 12 caracteres na senha).
PORTAL_ADMIN_USER=hunter
PORTAL_ADMIN_PASSWORD=
# Duração da sessão do portal em minutos (5 a 1440).
SESSION_TTL_MINUTES=480
# Cookies seguros: "true" se acessado via HTTPS ou localhost.
# Mude para "false" apenas se acessar via HTTP puro por IP de rede local.
COOKIE_SECURE=true
# Nível de log do backend: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- 5. Convenções e Pipelines do SIEM (Customizáveis) ------------------------
# Nome da label de pipeline (padrão: job).
DEFAULT_JOB_LABEL=job
# Pipeline esperado para os logs de endpoint/SIEM (padrão: wazuh).
DEFAULT_JOB_NAME=wazuh
# Label usada para segregação de tecnologias (padrão do Wazuh: rule_groups; retrocompatível com ss_groups).
DEFAULT_TECHNOLOGY_LABEL=rule_groups
# Intervalo padrão para o grupo de avaliação no Grafana Alerting.
DEFAULT_EVALUATION_GROUP=5m
# Pasta do Grafana onde reside o baseline institucional de regras de detecção.
DEFAULT_BASELINE_FOLDER=global

# --- 6. Provedores de Inteligência Artificial (Opcional) ----------------------
# Chaves de API para curadoria automatizada, tradução de regras Sigma e parecer técnico.
# As chaves também podem ser cadastradas diretamente pela tela no portal (/api-keys).
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=deepseek
AI_DEFAULT_MODEL=deepseek-chat

# --- 7. Atualizações In-App e Repositório GitHub ------------------------------
# Repositório oficial para verificação de versões e releases.
GITHUB_REPO=sg0luc/dante
# Token compartilhado de segurança com a API do Watchtower/Updater
UPDATER_TOKEN=dante-updater-secret-2026
