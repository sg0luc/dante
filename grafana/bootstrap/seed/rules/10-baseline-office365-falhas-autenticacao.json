  "annotations": {
    "summary": "Multiplas falhas de login no Microsoft 365 / Entra ID",
    "description": "Conta falhas de autenticacao (ResultStatus Failed/FailedOnly) no audit log do Microsoft 365. Mais de 5 falhas em 5 minutos indica password spraying ou forca bruta contra identidade em nuvem. Tecnica MITRE T1110.003 (Password Spraying).",
    "logql_query": "sum(count_over_time({job=\"wazuh\", rule_groups=~\".*office365.*\"} | json | data_office365_ResultStatus=~\"Failed|FailedOnly\" [5m]))",
    "runbook_url": "https://attack.mitre.org/techniques/T1110/003/"
  },
  "notification_settings": {
    "receiver": "dev"
  },
